; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotX Demo"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://addons/godetx/icons/godotx-mark.png"

[autoload]

GodotXRuntimeProbe="*uid://681eyxev004q"

[display]

window/size/viewport_width=900
window/size/viewport_height=540
window/size/window_width_override=900
window/size/window_height_override=540

[dotnet]

project/assembly_name="GodotX Demo"

[editor_plugins]

enabled=PackedStringArray("res://addons/godetx/plugin.cfg")

[feature_tags]

GodotX=""

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
