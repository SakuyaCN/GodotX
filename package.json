{
  "name": "godetx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none runtime/dist/test/*.test.js",
    "smoke:models": "npm run build && node runtime/dist/scripts/live-models.js",
    "smoke:hi": "npm run build && node runtime/dist/scripts/live-smoke.js hi",
    "smoke:agent": "npm run build && node runtime/dist/scripts/live-smoke.js agent"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "diff": "^8.0.2",
    "pngjs": "^7.0.0",
    "undici": "^7.28.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
